---
import Social from "./Social.astro";

const platform = [
  {
    platform: "GitHub",
    username: "bigcat86",
  },
  {
    platform: "LinkedIn",
    username: "bigcat86",
  },
  {
    platform: "Twitter",
    username: "bigcat86",
  },
];
---

<footer class="max-w-full h-20 text-white text-xl bg-indigo-500">
  <p>
    Learn more about my projects on  
  </p>
  <ul class="flex gap-4">
      {
        platform.map((site) => (
          <li>
            <Social platform={site.platform} username={site.username} />
          </li>
        ))
      }
  </ul>

</footer>

<style>
  footer {
    display: flex;
    justify-content: space-evenly;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
  }
</style>
