---
import Navigation from './Navigation.astro';

const location = Astro.url.pathname
---
<header class="fixed top-0 left-0 right-0 flex justify-center max-w-full bg-indigo-500 shadow-xl/30">
    <nav>
        <Navigation activeLink={location} />
    </nav>
</header>   

<style>
  header {
    width: 100%;
    height: 8rem;
    padding: 1.5rem;
  }

</style>